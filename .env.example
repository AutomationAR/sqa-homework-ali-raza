# Copy to .env and adjust if needed. Every value here is OPTIONAL:
# the Playwright suite runs green with no .env file at all and no credentials.

# Target under test. Override to point the suite at staging.
BASE_URL=https://ask.permission.ai

# --- LLM relevance evaluation (optional) -------------------------------------
# The relevance grader in eval/relevance-grader.js has two modes:
#   * no key set  -> deterministic lexical grader (default, always runnable)
#   * key set     -> LLM-as-judge rubric, which catches semantic irrelevance
#                    that lexical overlap cannot
# Set ONE of the following to enable LLM mode.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
